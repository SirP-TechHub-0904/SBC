@page
@model RazorWebUI.Areas.Dashboard.Pages.Admin.StateModel
@{
}
<div class="card">
    <div class="card-header">
        <h3 class="card-title">
            DASHBOARD (PARTICIPANTS BY STATES)
        </h3>


    </div>
    <!-- /.card-header -->
    <div class="card-body">
        <div class="row">

            @foreach (var data in Model.DataListDto)
            {


                <div class="col-lg-3 col-6 dashboard-1">
                    <a asp-page="/Category/Index" asp-route-state="@data.DataTitle" asp-area="ITrainings">
                        <!-- small box -->
                        <div class="small-box @data.DataColor">
                            <div class="inner">
                                <h3 style="font-size: 0.72rem;">@data.CategoryCount Category / @data.TrainingCount Training</h3>

                                <p>@data.DataTitle (Participants)</p>
                            </div>

                        </div>
                    </a>
                </div>
            }
        </div>
    </div>
</div>